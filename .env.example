# Flint Environment Variables
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (if using something other than SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/flint

# Add other credentials below as needed
# EXAMPLE_API_KEY=your-api-key-here

# Encryption
ENCRYPTION_KEY=your-encryption-key-here

# AI Provider API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Celery / Background tasks (defaults work for local Redis on port 6379)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
